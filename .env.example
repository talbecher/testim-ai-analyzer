# Copy to `.env` and/or `.env.local` for local development.
#
# Dev server runs at http://localhost:8080 (see vite.config.ts), NOT 5173.
#
# 1) Start API: `supabase start`
# 2) Print keys: `supabase status -o env` — paste ANON_KEY if it differs from the default below.
#
# Use http://127.0.0.1:54321 — the Supabase client runs in the browser, which shares the host
# loopback with `supabase start`. Do NOT use host.docker.internal for VITE_SUPABASE_URL (that
# hostname is for processes inside Docker calling the host, not for the browser).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Alternative: VITE_SUPABASE_PUBLISHABLE_KEY works as fallback in client.ts

# Auth: enable Email provider in Supabase Dashboard → Authentication → Providers.
# Add redirect URLs for password reset: http://localhost:8080/** and your production URL.

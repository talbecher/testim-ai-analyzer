# Local development + debugging (Vite HMR). Use with docker-compose.yml
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN chmod +x docker-entrypoint-dev.sh

EXPOSE 8080

ENTRYPOINT ["./docker-entrypoint-dev.sh"]
# Bind all interfaces so the app is reachable from the host through port mapping
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "8080"]
